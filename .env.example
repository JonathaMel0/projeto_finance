# Copie este arquivo para ".env.local" e preencha os valores reais.
# Nenhuma credencial real deve ser commitada no repositório.

# --- Telegram ---
# Token obtido com o @BotFather
TELEGRAM_BOT_TOKEN=
# Segredo aleatório (A-Z, a-z, 0-9, _ e -; até 256 caracteres). O Telegram o
# envia no header X-Telegram-Bot-Api-Secret-Token; use o mesmo valor no setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# IDs numéricos dos usuários autorizados, separados por vírgula (ex.: 123456,789012)
AUTHORIZED_TELEGRAM_USERS=

# --- Google Sheets ---
# ID da planilha (está na URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
# E-mail da service account criada no Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada da service account (bloco "private_key" do JSON baixado).
# Mantenha as quebras de linha como "\n" (uma única linha, entre aspas).
GOOGLE_PRIVATE_KEY=

# --- Autenticação (a ser implementado em etapa futura) ---
# AUTH_SECRET=
